{
  "name": "wayward",
  "private": true,
  "version": "0.0.0",
  "description": "Asteroid Blaster rebuilt in 3D for the web, on desktop and mobile.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "pilot": "vitest run --config tools/vitest.config.ts tools/balance.pilot.ts",
    "pilot:breakout": "vitest run --config tools/vitest.config.ts tools/breakout.pilot.ts",
    "pilot:journey": "vitest run --config tools/vitest.config.ts tools/journey.pilot.ts",
    "pilot:ship": "vitest run --config tools/vitest.config.ts tools/ship.pilot.ts",
    "pilot:endings": "vitest run --config tools/vitest.config.ts tools/endings.pilot.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
