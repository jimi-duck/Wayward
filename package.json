{
  "name": "wayward",
  "private": true,
  "version": "0.0.0",
  "description": "A dystopian 3D space survival game for desktop and mobile browsers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "tokens": "node tools/make-ui-tokens.mjs",
    "pilot": "vitest run --config tools/vitest.config.ts tools/balance.pilot.ts",
    "pilot:breakout": "vitest run --config tools/vitest.config.ts tools/breakout.pilot.ts",
    "pilot:journey": "vitest run --config tools/vitest.config.ts tools/journey.pilot.ts",
    "pilot:road": "vitest run --config tools/vitest.config.ts tools/road.pilot.ts",
    "pilot:overhaul": "vitest run --config tools/vitest.config.ts tools/overhaul.pilot.ts",
    "pilot:ship": "vitest run --config tools/vitest.config.ts tools/ship.pilot.ts",
    "pilot:survival": "vitest run --config tools/vitest.config.ts tools/survival.pilot.ts",
    "pilot:endings": "vitest run --config tools/vitest.config.ts tools/endings.pilot.ts",
    "pilot:space": "vitest run --config tools/vitest.config.ts tools/space.pilot.ts",
    "pilot:jobs": "vitest run --config tools/vitest.config.ts tools/jobs.pilot.ts",
    "pilot:situations": "vitest run --config tools/vitest.config.ts tools/situations.pilot.ts",
    "pilot:comms": "vitest run --config tools/vitest.config.ts tools/comms.pilot.ts",
    "pilot:upgrades": "vitest run --config tools/vitest.config.ts tools/upgrades.pilot.ts",
    "pilot:forks": "vitest run --config tools/vitest.config.ts tools/forks.pilot.ts",
    "pilot:perf": "vitest run --config tools/vitest.config.ts tools/perf.pilot.ts",
    "art:brief": "vitest run --config tools/vitest.config.ts tools/art-brief.pilot.ts",
    "art:prep": "python3 tools/art-prep.py",
    "pilot:variety": "vitest run --config tools/vitest.config.ts tools/variety.pilot.ts",
    "pilot:arcade": "vitest run --config tools/vitest.config.ts tools/arcade.pilot.ts",
    "pilot:feel": "vitest run --config tools/vitest.config.ts tools/feel.pilot.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
