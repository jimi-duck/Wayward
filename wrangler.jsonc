// Cloudflare Workers Builds deploys the game as a static-assets-only Worker.
// With this file present, `wrangler deploy` uploads dist/ as-is instead of
// trying to auto-configure the project (which fails on our Vite config).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayward",
  "compatibility_date": "2026-10-01",
  // build the site first, so the deploy never depends on a build command
  // being set in the Cloudflare dashboard
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
