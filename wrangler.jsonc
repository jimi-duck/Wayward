// Cloudflare Workers Builds deploys the game as a static-assets-only Worker.
// With this file present, `wrangler deploy` uploads dist/ as-is instead of
// trying to auto-configure the project (which fails on our Vite config).
// Pull requests deploy with `wrangler preview`, which needs a `previews`
// block (empty is fine: assets and settings stay at the top level).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayward",
  "compatibility_date": "2026-10-01",
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
